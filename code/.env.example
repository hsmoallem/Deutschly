# Database Connection
# For local development with SQLite: "file:./dev.db"
# For production Contabo VPS with PostgreSQL: "postgresql://username:password@localhost:5432/deutschly?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
